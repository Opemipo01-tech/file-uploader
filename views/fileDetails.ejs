<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title><%= file.name %> - File Details</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <main class="container">

    <div class="card file-details">

      <h1>File Details</h1>

      <div class="detail-row">

        <span class="detail-label">
          File name
        </span>

        <span>
          <%= file.name %>
        </span>

      </div>


      <div class="detail-row">

        <span class="detail-label">
          File size
        </span>

        <span>
          <%= file.size %> bytes
        </span>

      </div>


      <div class="detail-row">

        <span class="detail-label">
          Uploaded
        </span>

        <span>
          <%= file.uploadedAt.toLocaleString() %>
        </span>

      </div>


      <div class="detail-actions">

        <a
          class="btn"
          href="/file/<%= file.id %>/download"
        >
          Download
        </a>

        <a
          class="btn btn-secondary"
          href="/folders/<%= file.folderId %>"
        >
          Back to Folder
        </a>

      </div>

    </div>

  </main>

</body>
</html>