<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>File Uploader</title>

  <link rel="stylesheet" href="/styles.css">
</head>

<body>

  <nav class="nav">
    <div class="nav-logo">
      File Uploader
    </div>

    <div class="nav-links">
      <% if (user) { %>
        <a class="btn btn-secondary" href="/log-out">Log Out</a>
      <% } else { %>
        <a class="link" href="/sign-up">Sign Up</a>
        <a class="btn" href="/login">Log In</a>
      <% } %>
    </div>
  </nav>


  <main class="container">

    <% if (user) { %>

      <div class="dashboard-header">
        <div>
          <h1>Welcome, <%= user.firstname %> 👋</h1>
          <p>Manage your files and folders.</p>
        </div>

        <a class="btn" href="/create">
          + New Folder
        </a>
      </div>


      <section class="folder-section">

        <h2>My Folders</h2>

        <% if (folders.length === 0) { %>

          <div class="empty-state">
            <p>You don't have any folders yet.</p>

            <a class="btn" href="/create">
              Create your first folder
            </a>
          </div>

        <% } else { %>

          <ul class="folder-list">

            <% folders.forEach(folder => { %>

              <li class="folder-card">

                <a href="/folders/<%= folder.id %>">

                  <div class="folder-icon">
                    📁
                  </div>

                  <div class="folder-name">
                    <%= folder.name %>
                  </div>

                </a>

              </li>

            <% }) %>

          </ul>

        <% } %>

      </section>

    <% } else { %>

      <div class="form-container">

        <div class="card">
          <h1>File Uploader</h1>

          <p>
            Store and manage your files securely.
          </p>

          <br>

          <a class="btn" href="/sign-up">
            Create an account
          </a>

          <a class="btn btn-secondary" href="/login">
            Log In
          </a>
        </div>

      </div>

    <% } %>

  </main>

</body>
</html>