<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>File Uploader</title>
</head>

<body>

  <h1>File Uploader</h1>

  <% if (user) { %>
    
    <a href="/create">New-Folder</a>
    
    <h2>Welcome, <%= user.firstname %>!</h2>
    <h3>My folders</h3>
    
      <% if (folders.length === 0) { %>

      <p>You don't have any folder yet.</p>

    <% } else { %>

      <ul>
        <% folders.forEach(folder => { %>

          <li>
            <a href="/folders/<%= folder.id %>">
              <%= folder.name %>
            </a>
          </li>

        <% }) %>
      </ul>

    <% } %>

 <a href="/log-out">Log Out</a>

  <% } else { %>

    <a href="/sign-up">Sign Up</a>

    <a href="/log-in">Log In</a>

  <% } %>

</body>
</html>